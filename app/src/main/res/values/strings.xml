    <string name="settings_group_assistance">Call for help</string>
    <string name="settings_assistance_desc">Puts a red bell on the keyboard that calls one number. Leave this empty and there is no bell.</string>
    <string name="settings_assistance_name">Who it calls</string>
    <string name="settings_assistance_name_hint">A name the person using the keyboard will recognise. It is read out before the call starts.</string>
    <string name="settings_assistance_number">Phone number</string>
    <string name="settings_assistance_countdown">The keyboard says who it is calling and waits a few seconds first, so a bell pressed by accident can be stopped with a second press.</string>
    <string name="settings_assistance_allow">Allow PictoKeyboard to make calls</string>
    <string name="settings_assistance_allow_why">Without this the bell opens the phone app with the number already in it, and somebody still has to press the call button — which is the part the person using this keyboard may not be able to do.</string>
