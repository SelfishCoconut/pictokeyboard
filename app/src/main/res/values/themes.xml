<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        No android:statusBarColor here on purpose. Android 15 ignores it for apps
        targeting SDK 35, and on older releases enableEdgeToEdge() overrides it.
        The bar is transparent and the colour behind it comes from whatever the
        screen draws there: the TopAppBar container on every screen that has one.
    -->
    <style name="Theme.PictoKeyboard" parent="Theme.Material3.DayNight.NoActionBar" />

    <style name="KbControlKey">
        <item name="android:layout_marginStart">3dp</item>
        <item name="android:layout_marginEnd">3dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:background">@drawable/bg_control_key</item>
        <item name="android:textColor">@color/kb_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

</resources>
