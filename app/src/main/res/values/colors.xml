<?xml version="1.0" encoding="utf-8"?>
<!--
    The same tokens as ui/theme/Tokens.kt, for the parts of the product that are
    Views rather than Composables: the keyboard, and the window background.

    Two layers, one palette. The names match the Kotlin tokens exactly so a change
    made in one place is findable in the other, and the contrast table that governs
    both is asserted in TokenContrastTest.

    values-night/ overrides these. Anything added here needs an answer there too.
-->
<resources>
    <!-- Chrome background, for both the app window and the keyboard. -->
    <color name="paper">#FFFFFFFF</color>

    <!-- The config app's raised surface. Unlike `tile`, this follows the scheme. -->
    <color name="card">#FFFFFFFF</color>

    <!--
        Surfaces carrying ARASAAC artwork. Stays white in dark mode as well: the
        pictograms are black line work and a dark tile destroys them. Its content
        colours are therefore scheme-invariant too - see on_tile.
    -->
    <color name="tile">#FFFFFFFF</color>
    <color name="on_tile">#FF101828</color>
    <color name="on_tile_soft">#FF5A6472</color>

    <color name="ink">#FF101828</color>
    <color name="ink_soft">#FF4A5568</color>

    <!-- Decorative only: dividers, unpressed key fill. See line_strong. -->
    <color name="line">#FFDCE5F0</color>

    <!-- Anything outlining a control the user has to find. Verified at 3:1. -->
    <color name="line_strong">#FF5A7CA6</color>

    <color name="accent">#FF1A56A8</color>
    <color name="on_accent">#FFFFFFFF</color>

    <!--
        Destructive actions, error text, and the one key on the keyboard that
        calls somebody (#144). The layout default only; KeyboardPalette repaints
        it from the same token so high contrast reaches it too.
    -->
    <color name="danger">#FFA02B22</color>
    <color name="on_danger">#FFFFFFFF</color>
</resources>
