<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/kb_background"
    android:orientation="vertical">

    <!-- Control row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="4dp">

        <Button
            android:id="@+id/key_settings"
            style="@style/KbControlKey"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:contentDescription="@string/kb_settings"
            android:text="@string/kb_settings_icon" />

        <Button
            android:id="@+id/key_switch"
            style="@style/KbControlKey"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:contentDescription="@string/kb_switch"
            android:text="@string/kb_switch_icon" />

        <Button
            android:id="@+id/key_space"
            style="@style/KbControlKey"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/kb_space" />

        <Button
            android:id="@+id/key_backspace"
            style="@style/KbControlKey"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:contentDescription="@string/kb_backspace"
            android:text="@string/kb_backspace_icon" />

        <Button
            android:id="@+id/key_enter"
            style="@style/KbControlKey"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:contentDescription="@string/kb_enter"
            android:text="@string/kb_enter_icon" />
    </LinearLayout>

    <!-- Body: categories (left) + pictos (right) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/kb_body_height"
        android:orientation="horizontal">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list_categories"
            android:layout_width="@dimen/kb_category_width"
            android:layout_height="match_parent"
            android:background="@color/kb_category_panel"
            android:clipToPadding="false"
            android:padding="4dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/grid_pictos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:padding="4dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/empty_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="12dp"
        android:text="@string/kb_empty_hint"
        android:textColor="@color/kb_hint"
        android:visibility="gone" />

</LinearLayout>
