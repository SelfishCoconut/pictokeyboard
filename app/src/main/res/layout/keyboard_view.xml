<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/paper"
    android:orientation="vertical">

    <!--
        Board tabs. Two axes, and they mean different things: horizontal along the
        top is which *board* — which situation you are in — and vertical down the
        left is which *category*. That maps onto the only two things a
        communicator ever changes, and once learned it does not need re-learning.

        Gone entirely when the caregiver has fewer than two boards to show, which
        is everyone on day one: a tab strip with one tab in it is 52dp of height
        spent saying nothing. See PictoKeyboardService.applyBoardTabs.
    -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list_boards"
        android:layout_width="match_parent"
        android:layout_height="@dimen/kb_tab_height"
        android:background="@color/line"
        android:clipToPadding="false"
        android:visibility="gone" />

    <!--
        The phrase's own keys, in three groups: reach a word, act on the whole
        phrase, and call somebody.

        The strip of text that used to sit above them is gone (#148). It showed
        `yo · niño · papá` directly over a field already reading `yo niño papá`
        — a second copy of what the user was looking at, for 30dp taken from the
        grid, which is the whole product. What it was really carrying now lives
        where it belongs: the phrase is in the host's field, the word the arrows
        are on is the host's own selection, and 🔊 reads the phrase aloud for
        anybody who cannot use either.

        Every key is layout_weight="1" with minWidth overridden to zero, so the
        row divides evenly however many of them are showing. Two are usually
        not: Beautify needs a model on disk and the bell needs a number in
        settings, and each is gone rather than greyed — a key that cannot do
        anything is worse than no key on a surface this small.
    -->
    <LinearLayout
        android:id="@+id/sentence_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/kb_sentence_bar_height"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        android:paddingVertical="2dp">

        <!--
            Call for help (#144), at the leading edge and on its own.

            It was last, past backspace and clear (#159). This is the only
            control on the keyboard that reaches somebody who is not in the
            room, and it was the furthest thing from a resting thumb, behind
            every key that edits text. Now nothing is passed over to reach it,
            and the gap after it keeps it clear of the keys it must never be
            confused with.

            Gone unless the caregiver has entered a number. Its colours come
            from KeyboardPalette like every other key's, so high contrast
            reaches it too.
        -->
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/key_assistance"
            style="@style/KbKey.Recessive"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_key_assistance"
            android:contentDescription="@string/kb_assistance"
            android:minWidth="0dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_assistance"
            android:visibility="gone"
            app:tint="@color/on_danger" />

        <!--
            Beautify (#46). Gone entirely, not merely disabled, unless
            sentence help is switched on and a model is actually present.

            Nothing runs until it is pressed. The words already reached the
            field the instant each picto was tapped; this only offers to say
            them better, and undo puts back exactly what was typed.
        -->
        <Button
            android:id="@+id/key_beautify"
            style="@style/KbKey.Recessive"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/kb_beautify"
            android:minWidth="0dp"
            android:text="@string/kb_beautify_icon"
            android:visibility="gone" />

        <!--
            Speak, next to Beautify because one feeds the other: say it
            better, then say it.

            A vector rather than 🔊, so it takes the key's text colour and
            inverts with its pressed state. A colour emoji renders in its own
            palette, and on this surface the only saturated colour is meant to
            be the category hue, which carries meaning.
        -->
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/key_speak"
            style="@style/KbKey.Recessive"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/kb_speak_all"
            android:minWidth="0dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_speak"
            app:tint="@color/key_text_recessive" />

        <!--
            Walk the phrase (#143). Each press selects a word in the host's
            own field and says it out loud, so the highlight and the voice
            agree, and backspace then takes that word rather than the last.

            These three sit together at the trailing edge (#159): they are the
            keys that move through text and remove it, and they are used one
            after another — arrow to the wrong word, then delete it.
        -->
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/key_prev_word"
            style="@style/KbKey.Recessive"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/kb_prev_word"
            android:minWidth="0dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_prev_word"
            app:tint="@color/key_text_recessive" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/key_next_word"
            style="@style/KbKey.Recessive"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/kb_next_word"
            android:minWidth="0dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_next_word"
            app:tint="@color/key_text_recessive" />

        <!--
            Backspace lives here rather than in the action row, beside the
            words it removes. It was one of four identical grey keys along the
            bottom, which is where word-level undo went to be undiscoverable.
        -->
        <Button
            android:id="@+id/key_backspace"
            style="@style/KbKey.Recessive"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/kb_backspace"
            android:minWidth="0dp"
            android:text="@string/kb_backspace_icon" />
    </LinearLayout>

    <!--
        Body: the category spine on the left, the picto grid on the right.

        The grid's background is set in code to a 6% wash of the selected
        category's colour, so the whole surface takes on that hue. Tap Comida and
        the keyboard reads orange, tap Acciones and it reads green. That gives a
        user who cannot read a full-field signal of which context they are in,
        which is the job AAC colour coding exists to do and was previously spent
        on a 3dp frame.

        layout_weight="1" so the body absorbs any height shortfall rather than the
        action row below it. Without it, moving the action row to the bottom of a
        wrap_content column made it the child that falls off the screen when the
        framework constrains the input area (landscape, or fullscreen extract
        mode). Losing space, backspace and enter is far worse than losing a grid
        row, which scrolls anyway.
    -->
    <LinearLayout
        android:id="@+id/keyboard_body"
        android:layout_width="match_parent"
        android:layout_height="@dimen/kb_body_height"
        android:layout_weight="1"
        android:orientation="horizontal">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list_categories"
            android:layout_width="@dimen/kb_category_width"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="6dp"
            android:paddingEnd="0dp"
            android:paddingVertical="4dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/grid_pictos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:padding="4dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/empty_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/atkinson_hyperlegible"
        android:gravity="center"
        android:padding="12dp"
        android:text="@string/kb_empty_hint"
        android:textColor="@color/ink_soft"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- A hairline so the action row reads as chrome, not as part of the board. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/kb_hairline"
        android:background="@color/line" />

    <!--
        Action row: field-level operations, where a thumb naturally rests rather
        than above the content it acts on. `space` is the primary key because it
        is what the user reaches for between words.

        The ⚙ key is gone. It launched the whole caregiver app from the
        communicator's keyboard, mid-conversation, with no easy path back — a trap
        sitting permanently under the thumb of the person least able to get out of
        it. Configuration is the app's job (#16, #36).
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/kb_action_row_height"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        android:paddingVertical="6dp">

        <!--
            An image key rather than a Button with an emoji, so the glyph takes the
            key's text colour and inverts with the pressed state like the others.
            See drawable/ic_switch_keyboard.xml.

            Named explicitly as the AppCompat widget because an IME inflates its
            views from a Service, which has no AppCompat view inflater to swap the
            plain ImageButton out - and app:tint is only honoured by the AppCompat
            one.
        -->
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/key_switch"
            style="@style/KbKey.Recessive"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:contentDescription="@string/kb_switch"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_switch_keyboard"
            app:tint="@color/key_text_recessive" />

        <Button
            android:id="@+id/key_space"
            style="@style/KbKey.Primary"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/kb_space" />

        <Button
            android:id="@+id/key_enter"
            style="@style/KbKey.Recessive"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:contentDescription="@string/kb_enter"
            android:text="@string/kb_enter_icon" />
    </LinearLayout>

</LinearLayout>
