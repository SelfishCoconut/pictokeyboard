<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/picto_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="4dp">

    <org.pictokeyboard.ime.TileFrameLayout
        android:id="@+id/picto_tile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/picto_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:padding="8dp"
            android:scaleType="fitCenter" />
    </org.pictokeyboard.ime.TileFrameLayout>

    <!--
        The caption sits below the tile, on the washed grid background, so it takes
        `ink` rather than the tile's own content colour.

        It is 14sp/700 in Atkinson, up from 12sp in the platform sans, and it has
        no maxLines and no ellipsize: truncating the word the user is trying to say
        is a defect, not a layout compromise. Long words wrap instead. Autosizing
        it to fit two lines was considered and rejected - shrinking text overrides
        the system font-size setting, which is the one accessibility control the
        user has already told us about, and an uneven grid row is a far smaller
        cost than a caption the user cannot read.
    -->
    <TextView
        android:id="@+id/picto_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/atkinson_hyperlegible"
        android:gravity="center"
        android:textColor="@color/ink"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
