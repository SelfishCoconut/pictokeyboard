    <string name="about_title">Acerca de y créditos</string>
    <string name="about_app">PictoKeyboard es un teclado de pictogramas diseñado para personas con dificultades del habla o de escritura.</string>
    <string name="about_pictos_heading">Créditos de los pictogramas</string>
    <string name="about_arasaac_attribution">Los símbolos pictográficos utilizados son propiedad del Gobierno de Aragón y han sido creados por Sergio Palao para ARASAAC (https://arasaac.org), que los distribuye bajo una licencia Creative Commons (BY-NC-SA).</string>
    <string name="about_license_heading">Licencia</string>
    <string name="about_license_noncommercial">Los pictogramas se ofrecen bajo CC BY-NC-SA 4.0 y NO pueden usarse con fines comerciales. Se exige atribución y compartir bajo la misma licencia.</string>
    <string name="about_license_link">Ver licencia CC BY-NC-SA 4.0</string>
    <string name="about_terms_link">Términos de uso de ARASAAC</string>
    <string name="about_website_link">Sitio web de ARASAAC</string>

    <!-- El resumen responde a la pregunta que, si no, obligaría a salir de la
         aplicación para resolverla. Empieza por el teclado, que es la parte con
         la capacidad que asusta. -->
    <string name="about_privacy_heading">Privacidad</string>
    <string name="about_privacy_summary">Lo que se escribe nunca sale de este teléfono. Los tableros, los pictogramas y las fotografías también se quedan en el dispositivo. Esta aplicación no tiene rastreo, ni publicidad, ni analíticas.</string>
    <string name="about_privacy_link">Leer la política de privacidad</string>

