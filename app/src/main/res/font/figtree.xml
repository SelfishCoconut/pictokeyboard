<?xml version="1.0" encoding="utf-8"?>
<!--
    Figtree (OFL). The caregiver's admin chrome: body copy, labels, settings rows.
    Only the two weights the type scale actually asks for are bundled.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/figtree_regular"
        android:fontStyle="normal"
        android:fontWeight="400" />
    <font
        android:font="@font/figtree_medium"
        android:fontStyle="normal"
        android:fontWeight="500" />
</font-family>
